datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// --- AUTHENTICATION (NextAuth) ---
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(EDITOR)
  password      String?   // Hashed
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[] // Track user actions
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@map("users")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

// --- SYSTEM LOGS ---
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // e.g. "CREATE", "UPDATE", "DELETE"
  entity    String   // e.g. "Project", "TeamMember"
  entityId  String
  details   String?  // JSON details of change
  createdAt DateTime @default(now())
  @@map("audit_logs")
}

// --- HR & ORG CHART ---
model Employee {
  id             String    @id @default(cuid())
  firstName      String
  lastName       String
  email          String?   @unique
  phone          String?
  image          String?
  bio            String?   @db.Text
  experience     String?
  location       String?
  specialization String?
  orgUnits       OrgUnit[]
  articles       NewsArticle[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@map("employees")
}

model Department {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  orgUnits    OrgUnit[]
  jobs        JobPosting[]
  documents   Document[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("departments")
}

model OrgUnit {
  id           String       @id @default(cuid())
  title        String
  type         OrgUnitType  @default(STAFF)
  parentId     String?
  parent       OrgUnit?     @relation("OrgHierarchy", fields: [parentId], references: [id])
  children     OrgUnit[]    @relation("OrgHierarchy")
  employeeId   String?
  employee     Employee?    @relation(fields: [employeeId], references: [id])
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  orderIndex   Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  @@map("org_units")
}

enum OrgUnitType {
  DIRECTOR
  MANAGER
  STAFF
  DEPARTMENT_HEAD
}

// --- PORTFOLIO ---
model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    ProjectCategory
  status      ProjectStatus @default(ONGOING)
  location    String?
  client      String?
  completionDate DateTime?
  description String?  @db.Text
  heroImage   String?
  gallery     ProjectImage[]
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("projects")
}

model ProjectImage {
  id        String  @id @default(cuid())
  url       String
  caption   String?
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@map("project_images")
}

enum ProjectCategory {
  GOVERNMENT
  PUBLIC_SERVICE
  PRIVATE
  INFRASTRUCTURE
  WATER_TREATMENT
  SYSTEMS
}

enum ProjectStatus {
  COMPLETED
  ONGOING
}

// --- SERVICES ---
model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  icon        String?
  summary     String?
  description String   @db.Text
  image       String?
  features    String[]
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("services")
}

// --- TRUST SIGNALS ---
model Partner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  website   String?
  type      PartnerType @default(CLIENT)
  orderIndex Int     @default(0)
  @@map("partners")
}

enum PartnerType {
  CLIENT
  PARTNER
  GOVERNMENT
}

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  clientRole  String?
  company     String?
  content     String   @db.Text
  rating      Int      @default(5)
  image       String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@map("testimonials")
}

// --- ADVANCED CONTENT ---
model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String   @db.Text
  coverImage  String?
  publishedAt DateTime @default(now())
  category    NewsCategory
  tags        String[]
  authorId    String?
  author      Employee? @relation(fields: [authorId], references: [id])
  isFeatured  Boolean  @default(false)
  metaTitle       String?
  metaDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("news_articles")
}

enum NewsCategory {
  CORPORATE
  ENVIRONMENT
  CSR
  INDUSTRY
  ANNOUNCEMENT
}

model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileSize    String?
  fileType    String?
  thumbnailUrl String?
  category    DocumentCategory
  departmentId String?
  department  Department? @relation(fields: [departmentId], references: [id])
  isPublic      Boolean @default(true)
  downloadCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("documents")
}

enum DocumentCategory {
  ANNUAL_REPORT
  COMPANY_PROFILE
  POLICY
  MANUAL
  CERTIFICATE
  PRESS_KIT
  OTHER
}

// --- CAREERS & CRM ---
model JobPosting {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id])
  location         String   @default("Phnom Penh")
  type             JobType  @default(FULL_TIME)
  summary          String   @db.Text
  requirements     String[]
  benefits         String[]
  isActive         Boolean  @default(true)
  closingDate      DateTime?
  applications     JobApplication[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@map("job_postings")
}

model JobApplication {
  id           String   @id @default(cuid())
  jobId        String
  job          JobPosting @relation(fields: [jobId], references: [id])
  applicantName String
  email        String
  phone        String
  resumeUrl    String
  coverLetter  String?  @db.Text
  status       ApplicationStatus @default(PENDING)
  submittedAt  DateTime @default(now())
  @@map("job_applications")
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  projectType String?
  message   String   @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("inquiries")
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEW
  OFFERED
  REJECTED
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}
